  {
   "id": "R1",
   "nombre": "Participante activo sin consentimiento de atención",
   "descripcion": "Todo participante activo debe tener un consentimiento vigente para la finalidad de atención del programa.",
   "sql": "SELECT p.participante_id FROM participante p WHERE p.fecha_egreso IS NULL AND NOT EXISTS (SELECT 1 FROM v_consentimiento_vigente c WHERE c.participante_id = p.participante_id AND c.finalidad = 'Atención del programa')"
  },
  {
   "id": "R2",
   "nombre": "Solicitud de derechos abierta sobre el umbral interno",
   "descripcion": "Solicitudes sin respuesta con más de 30 días corridos desde su recepción. El umbral es interno y conservador: el plazo legal lo fija la ley y su reglamento.",
   "sql": "SELECT solicitud_id FROM solicitud_derecho WHERE fecha_respuesta IS NULL AND julianday(:corte) - julianday(fecha_recepcion) > 30"
  },
  {
   "id": "R3",
   "nombre": "Consentimiento de investigación con participante egresado",
   "descripcion": "Los datos de un participante egresado no deben seguir alimentando estudios si su consentimiento sigue abierto sin revisión.",
   "sql": "SELECT c.participante_id FROM v_consentimiento_vigente c JOIN participante p USING (participante_id) WHERE c.finalidad = 'Investigación y estadística' AND p.fecha_egreso IS NOT NULL AND julianday(:corte) - julianday(p.fecha_egreso) > 365"
  }
 ],
